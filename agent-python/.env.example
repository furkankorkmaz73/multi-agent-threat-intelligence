# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=threat_intel
MONGO_SERVER_SELECTION_TIMEOUT_MS=1500
MONGO_CONNECT_TIMEOUT_MS=1500

# External feeds
CVE_KEY=replace_with_nvd_api_key

# Optional LLM enrichment
# Disabled by default. Set LLM_ENABLED=1 and provide LLM_API_KEY or
# OPENAI_API_KEY to enable OpenAI-compatible assistive extraction.
LLM_ENABLED=0
LLM_API_KEY=
# Leave unset unless using an OpenAI-compatible proxy/provider endpoint.
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=10
LLM_MAX_INPUT_CHARS=4000
LLM_MAX_RETRIES=2
LLM_DEBUG=0
# Backward-compatible aliases. API keys alone do not enable LLM calls.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# API / frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE=http://127.0.0.1:8000
API_AUTH_MODE=development
# Format: key:role:actor_id. Roles: viewer, analyst, operator, admin.
API_KEYS=
API_DEV_ACTOR_ID=local-dev
API_DEV_ROLE=admin

# Runtime
DEFAULT_BATCH_SIZE=20
DEFAULT_IDLE_SLEEP=10
DEFAULT_ACTIVE_SLEEP=5
DEFAULT_REPORT_LIMIT=5

# Risk scoring defaults
BASE_CVSS_MULTIPLIER=0.72
ZERO_CVSS_FALLBACK=1.5
GRAPH_BONUS_MULTIPLIER=0.55
GRAPH_BONUS_CAP=0.6
URLHAUS_SCORE_CAP=2.8
DREAD_SCORE_CAP=2.5
LLM_BONUS_CAP=0.8
MIN_SHARED_TERMS=2
MIN_LEXICAL_OVERLAP=0.08
MIN_SEMANTIC_SUPPORT=0.22
SEMANTIC_ENABLED=1
SEMANTIC_BACKEND=fallback
SEMANTIC_SIMILARITY_FLOOR=0.22

# Optional experimental Dread collection
DREAD_ENABLED=false
DREAD_ONION_URL=
DREAD_REQUEST_TIMEOUT_SECONDS=90
