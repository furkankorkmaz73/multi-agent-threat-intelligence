# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=threat_intel
MONGO_SERVER_SELECTION_TIMEOUT_MS=1500
MONGO_CONNECT_TIMEOUT_MS=1500

# External feeds
# Keep CVE_KEY if the Go collector expects this name.
CVE_KEY=replace_with_nvd_api_key

# Optional LLM enrichment
# The deterministic pipeline works without LLM support.
# Generic provider-neutral names are preferred. The implementation uses an
# OpenAI-compatible SDK surface, so Gemini/Claude/OpenAI-compatible gateways can
# be used by changing LLM_API_KEY, LLM_BASE_URL and LLM_MODEL.
LLM_ENABLED=0
LLM_API_KEY=
# Leave unset unless using an OpenAI-compatible proxy/provider endpoint.
# Gemini example: https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=10
LLM_MAX_INPUT_CHARS=4000
LLM_MAX_RETRIES=2
LLM_DEBUG=0

# API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# API_AUTH_MODE=development keeps local/test usage unauthenticated.
# Set API_AUTH_MODE=api_key and provide API_KEYS for protected deployments.
API_AUTH_MODE=development
# Format: key:role:actor_id,another_key:admin:admin-1
# Roles: viewer, analyst, operator, admin
API_KEYS=
API_DEV_ACTOR_ID=local-dev
API_DEV_ROLE=admin

# Runtime
DEFAULT_BATCH_SIZE=20
DEFAULT_IDLE_SLEEP=10
DEFAULT_ACTIVE_SLEEP=5
DEFAULT_REPORT_LIMIT=5

# Semantic matching
SEMANTIC_ENABLED=1
SEMANTIC_BACKEND=fallback
SEMANTIC_SIMILARITY_FLOOR=0.22
SEMANTIC_ALLOW_DOWNLOAD=0

# Correlation thresholds
MIN_SHARED_TERMS=2
MIN_LEXICAL_OVERLAP=0.08
MIN_SEMANTIC_SUPPORT=0.22

# Optional experimental Dread collection
# Disabled by default. Do not enable for tests, demos, or thesis artifact generation.
DREAD_ENABLED=false
DREAD_ONION_URL=
DREAD_REQUEST_TIMEOUT_SECONDS=90
